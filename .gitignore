infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfplan
infra/terraform.tfvars

# Generated build, test, and local-runtime files do not belong in source control.
.local/
**/__pycache__/
**/.pytest_cache/
**/target/
**/node_modules/
.env
